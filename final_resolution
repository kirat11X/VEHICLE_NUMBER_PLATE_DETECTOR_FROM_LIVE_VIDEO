import json
from dataclasses import asdict, dataclass
from pathlib import Path

import cv2
import numpy as np

import filter


PROJECT_ROOT = Path("/home/kirat/my_proj_dream")
TRACK_SUMMARY_PATH = PROJECT_ROOT / "tracking_outputs" / "track_summary.json"
TRACKED_FRAMES_PATH = PROJECT_ROOT / "tracking_outputs" / "tracked_frames.json"
OUTPUT_DIR = PROJECT_ROOT / "final_resolution_outputs"

PADDING_RATIO = 0.04
UPSCALE_FACTOR = 2
MIN_PLATE_WIDTH = 40
MIN_PLATE_HEIGHT = 16
MIN_ASPECT_RATIO = 2.0
MAX_ASPECT_RATIO = 6.5
MIN_SHARPNESS = 40.0
ENABLE_DEEP_SR = False


@dataclass
class CropQuality:
    width: int
    height: int
    aspect_ratio: float
    sharpness: float
    brightness: float
    contrast: float
    valid_size: bool
    valid_aspect_ratio: bool
    valid_sharpness: bool


def load_json(path: Path):
    if not path.exists():
        raise FileNotFoundError(f"Missing required file: {path}")
    with path.open("r", encoding="utf-8") as input_file:
        return json.load(input_file)


def compute_crop_quality(image):
    gray = filter.to_gray(image)
    height, width = gray.shape[:2]
    aspect_ratio = width / max(height, 1)
    sharpness = float(cv2.Laplacian(gray, cv2.CV_64F).var())
    brightness = float(np.mean(gray))
    contrast = float(np.std(gray))

    return CropQuality(
        width=width,
        height=height,
        aspect_ratio=aspect_ratio,
        sharpness=sharpness,
        brightness=brightness,
        contrast=contrast,
        valid_size=width >= MIN_PLATE_WIDTH and height >= MIN_PLATE_HEIGHT,
        valid_aspect_ratio=MIN_ASPECT_RATIO <= aspect_ratio <= MAX_ASPECT_RATIO,
        valid_sharpness=sharpness >= MIN_SHARPNESS,
    )


def quality_score(quality: CropQuality):
    score = quality.sharpness * 0.6 + quality.contrast * 0.3 + quality.brightness * 0.1
    if not quality.valid_size:
        score -= 100
    if not quality.valid_aspect_ratio:
        score -= 100
    if not quality.valid_sharpness:
        score -= 50
    return float(score)


def resize_crop(image, scale=UPSCALE_FACTOR):
    return cv2.resize(
        image,
        None,
        fx=scale,
        fy=scale,
        interpolation=cv2.INTER_CUBIC,
    )


def enhance_plate_crop(image):
    enlarged = resize_crop(image)
    clahe = filter.clahe_enhance(enlarged, clip_limit=2.0, tile_grid_size=(8, 8))
    sharpened = filter.unsharp_mask(clahe, sigma=1.0, strength=0.8)

    return {
        "original": image,
        "resized_2x": enlarged,
        "clahe": clahe,
        "final": sharpened,
    }


def maybe_run_deep_sr(image):
    if not ENABLE_DEEP_SR:
        return None
    return None


def find_best_frame_record(track_id: int, tracked_frames: list[dict]):
    candidates = [record for record in tracked_frames if record["track_id"] == track_id]
    if not candidates:
        return None
    with_plate = [record for record in candidates if record.get("plate_bbox_xyxy")]
    if with_plate:
        return max(with_plate, key=lambda record: record["confidence"])
    return max(candidates, key=lambda record: record["confidence"])


def padded_plate_crop(source_image_path: Path, plate_bbox_xyxy):
    image = cv2.imread(str(source_image_path))
    if image is None:
        return None

    x1, y1, x2, y2 = plate_bbox_xyxy
    width = max(x2 - x1, 1)
    height = max(y2 - y1, 1)
    pad_x = int(width * PADDING_RATIO)
    pad_y = int(height * PADDING_RATIO)

    padded_bbox = [
        max(0, x1 - pad_x),
        max(0, y1 - pad_y),
        min(image.shape[1], x2 + pad_x),
        min(image.shape[0], y2 + pad_y),
    ]

    px1, py1, px2, py2 = padded_bbox
    crop = image[py1:py2, px1:px2]
    if crop.size == 0:
        return None
    return crop, padded_bbox


def save_stage_images(track_dir: Path, image_name_prefix: str, stage_images: dict):
    saved_paths = {}
    for stage_name, image in stage_images.items():
        stage_dir = track_dir / stage_name
        stage_dir.mkdir(parents=True, exist_ok=True)
        output_path = stage_dir / f"{image_name_prefix}.jpg"
        cv2.imwrite(str(output_path), image)
        saved_paths[stage_name] = str(output_path)
    return saved_paths


def process_track(track: dict, tracked_frames: list[dict]):
    track_id = track["track_id"]
    track_dir = OUTPUT_DIR / f"track_{track_id:04d}"

    best_frame_record = find_best_frame_record(track_id, tracked_frames)
    if best_frame_record is None or not best_frame_record.get("plate_bbox_xyxy"):
        return {
            "track_id": track_id,
            "status": "skipped",
            "reason": "No tracked plate bbox available for this vehicle.",
        }

    source_image_path = Path(best_frame_record["source_image"])
    padded_result = padded_plate_crop(source_image_path, best_frame_record["plate_bbox_xyxy"])
    if padded_result is None:
        return {
            "track_id": track_id,
            "status": "skipped",
            "reason": "Could not crop padded plate region from source frame.",
        }

    padded_crop, padded_bbox = padded_result
    original_quality = compute_crop_quality(padded_crop)

    if not original_quality.valid_size or not original_quality.valid_aspect_ratio:
        return {
            "track_id": track_id,
            "status": "rejected",
            "reason": "Plate crop failed size/aspect validation.",
            "quality": asdict(original_quality),
        }

    enhanced_images = enhance_plate_crop(padded_crop)
    deep_sr_image = maybe_run_deep_sr(enhanced_images["final"])
    if deep_sr_image is not None:
        enhanced_images["deep_sr"] = deep_sr_image

    final_quality = compute_crop_quality(enhanced_images["final"])
    saved_paths = save_stage_images(
        track_dir=track_dir,
        image_name_prefix=f"track{track_id}_frame{best_frame_record['frame_id']}",
        stage_images=enhanced_images,
    )

    return {
        "track_id": track_id,
        "status": "processed",
        "frame_id": best_frame_record["frame_id"],
        "timestamp": best_frame_record["timestamp"],
        "source_image": best_frame_record["source_image"],
        "track_confidence": best_frame_record["confidence"],
        "padded_plate_bbox_xyxy": padded_bbox,
        "input_quality": asdict(original_quality),
        "input_quality_score": quality_score(original_quality),
        "final_quality": asdict(final_quality),
        "final_quality_score": quality_score(final_quality),
        "best_plate_crop_from_tracking": track.get("best_plate_crop"),
        "saved_outputs": saved_paths,
        "deep_super_resolution": "pending" if not ENABLE_DEEP_SR else "enabled",
    }


def main():
    track_summary = load_json(TRACK_SUMMARY_PATH)
    tracked_frames = load_json(TRACKED_FRAMES_PATH)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    results = [process_track(track, tracked_frames) for track in track_summary]

    summary_path = OUTPUT_DIR / "plate_resolution_summary.json"
    with summary_path.open("w", encoding="utf-8") as output_file:
        json.dump(results, output_file, indent=2)

    processed = sum(1 for item in results if item["status"] == "processed")
    rejected = sum(1 for item in results if item["status"] == "rejected")
    skipped = sum(1 for item in results if item["status"] == "skipped")

    print(f"Processed tracks: {processed}")
    print(f"Rejected tracks: {rejected}")
    print(f"Skipped tracks: {skipped}")
    print(f"Summary saved to: {summary_path}")


if __name__ == "__main__":
    main()
